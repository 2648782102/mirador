#!/bin/sh
# Pre-push hook for the public clone: odd/tasks/ and design/ stay private. It rejects the push when
# any pushed commit's tree holds any path under either folder, with no exceptions. Install it with
# `pnpm run hooks:install` (scripts/install-hooks.sh); it is local to the clone that installs it.
#
# git runs it as `pre-push <remote name> <remote url>`, with one stdin line per pushed ref:
#   <local ref> <local sha> <remote ref> <remote sha>
# Commits to check: <remote sha>..<local sha>; for a new remote ref, or a remote sha this clone does
# not have, every commit of <local sha> not on any of the remote's tracking refs.

remote_name=${1:-origin}
max_paths=5
rejected=0

is_zero() {
  case $1 in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  # A deletion pushes no commit.
  if is_zero "$local_sha"; then continue; fi

  if ! is_zero "$remote_sha" && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    commits=$(git rev-list "$remote_sha..$local_sha") || commits=FAILED
  else
    commits=$(git rev-list "$local_sha" --not --remotes="$remote_name") || commits=FAILED
  fi
  if [ "$commits" = FAILED ]; then
    echo "pre-push: $remote_ref: could not list the commits to push, so they cannot be checked" >&2
    rejected=1
    continue
  fi

  for commit in $commits; do
    paths=$(git ls-tree -r --name-only "$commit" -- odd/tasks design) || paths="(git ls-tree failed)"
    [ -n "$paths" ] || continue
    count=$(printf '%s\n' "$paths" | wc -l | tr -d ' ')
    echo "pre-push: $remote_ref: commit $commit tracks private paths:" >&2
    printf '%s\n' "$paths" | head -n "$max_paths" | sed 's/^/  /' >&2
    if [ "$count" -gt "$max_paths" ]; then
      echo "  ... and $((count - max_paths)) more" >&2
    fi
    rejected=1
    # The first leaking commit is enough to reject this ref.
    break
  done
done

if [ "$rejected" -ne 0 ]; then
  echo "pre-push: push rejected; odd/tasks/ and design/ stay private and are never pushed from this clone." >&2
  exit 1
fi
exit 0
